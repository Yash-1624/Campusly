PORT=5000
CLIENT_URL=http://localhost:5173

# MongoDB connection string (local or Atlas)
MONGO_URI=mongodb://127.0.0.1:27017/college-event-management

# Gmail SMTP: use a Google App Password, not your normal Gmail password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-16-character-google-app-password
SMTP_FROM="Campus Events <your-email@gmail.com>"

# Replace this with a long random value before using the app beyond local development.
JWT_SECRET=replace-with-a-long-random-secret

# Required only when creating the initial administrator with `npm run seed:admin`.
# Use a private email and a unique password with at least 12 characters.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Optional; required only for payment features.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
